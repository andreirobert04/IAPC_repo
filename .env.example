# Copy to .env (cp .env.example .env) and adjust if needed. .env is git-ignored.
# No secrets are required right now: Ollama runs locally and Qdrant has no API key.

# Ollama runs on the host machine (GPU); containers reach it through host.docker.internal
OLLAMA_BASE_URL=http://host.docker.internal:11434
CHAT_MODEL=qwen2.5:1.5b
EMBEDDING_MODEL=nomic-embed-text:latest

# Qdrant
QDRANT_COLLECTION=rag_documents

# ingest-static: false = skip ingestion if the collection already has documents
APP_FORCE_REBUILD=false
# chunk size and overlap in tokens (changing them requires re-ingesting)
APP_CHUNK_SIZE=400
APP_CHUNK_OVERLAP=50

# retrieval-post
APP_RETRIEVAL_TOP_K=20
APP_SIMILARITY_THRESHOLD=0.0

# ingest-dynamic (Story 2, Task 3 - webhook HMAC secret). Not used yet.
# VENDOR_WEBHOOK_SECRET=
